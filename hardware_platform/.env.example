# Hardware Platform 环境配置

# === 设备桥地址 ===
LINK2_BRIDGE_URL=http://localhost:8002
X4AIR_BRIDGE_URL=http://localhost:8001

# === 云端服务 ===
CLOUD_ENDPOINT=https://your-cloud-service.com
CLOUD_API_KEY=your-cloud-api-key

# === 边缘代理 ===
LOCAL_MODE=false                    # true: 仅本地模式, false: 连接云端
OUTBOX_DIR=./data/outbox            # 断网时事件队列目录

# === 设备设置 ===
LINK2_DEVICE_INDEX=0                # Link 2 设备索引
X4AIR_DEVICE_INDEX=0                # X4 Air 设备索引

# === 日志 ===
LOG_LEVEL=INFO
LOG_FILE=./logs/hardware_platform.log
