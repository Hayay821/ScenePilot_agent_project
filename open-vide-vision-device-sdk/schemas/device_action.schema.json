{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-vide-vision.local/schemas/device_action.schema.json",
  "title": "经过校验的设备动作",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "device_id", "action", "approved", "rule_id", "evidence_id", "parameters"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "minLength": 1},
    "action": {
      "enum": ["capture_photo", "start_recording", "stop_recording", "start_preview", "stop_preview", "download_media", "set_tracking", "set_composition", "set_track_speed", "set_ptz", "set_zoom", "set_privacy", "shutdown"]
    },
    "approved": {"const": true},
    "rule_id": {"type": "string", "minLength": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "parameters": {"type": "object"}
  }
}


