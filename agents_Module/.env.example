# 百炼模型 API 配置
# 复制此文件为 .env 并填入真实值

# 百炼 API 配置
BAILIAN_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
BAILIAN_API_KEY=sk-your-api-key-here
BAILIAN_MODEL=qwen-plus

# 可选配置
# BAILIAN_TIMEOUT=30
# BAILIAN_MAX_RETRIES=3

# 说明：
# 1. 从阿里云百炼控制台获取 API Key
# 2. 推荐模型：
#    - qwen-max: 最强性能，适合复杂推理
#    - qwen-plus: 平衡性能和成本（推荐）
#    - qwen-turbo: 快速响应，适合简单任务
