# 百炼 API 配置（注意提交github不要提交真实 Key）
DASHSCOPE_API_KEY=your-api-key
DASHSCOPE_BASE_URL=https://llm-fq43z9u2tnoy3m7o.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3-vl-flash
QWEN_TEXT_MODEL=qwen3-vl-plus

# STC 压缩参数
STC_FRAME_DIFF_THRESHOLD=0.15
STC_HIST_DIFF_THRESHOLD=0.20
STC_PHASH_THRESHOLD=5
STC_MAX_GAP_SEC=3
STC_MIN_FRAMES_PER_WINDOW=1
STC_MAX_FRAMES_PER_WINDOW=4
STC_WINDOW_SIZE_SEC=4

# 视频输入配置
VIDEO_SAMPLE_FPS=2
VIDEO_MAX_DIMENSION=384
RING_BUFFER_DURATION_SEC=10

# 语义模型配置
SEMANTIC_BATCH_SIZE=3
SEMANTIC_TIMEOUT_SEC=30
SEMANTIC_MAX_RETRIES=2
SEMANTIC_CACHE_ENABLED=true

# 导演状态机配置
DIRECTOR_IDLE_TIMEOUT_MS=10000
DIRECTOR_SEARCH_TIMEOUT_MS=10000
DIRECTOR_RECOVER_TIMEOUT_MS=5000

# 高光剪辑配置
HIGHLIGHT_PREROLL_MS=3000
HIGHLIGHT_POSTROLL_MS=3000
HIGHLIGHT_MIN_DURATION_MS=2000

# 日志级别
LOG_LEVEL=INFO
