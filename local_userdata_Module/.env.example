# ============================================================
# BoldMaker 本地用户数据服务 - 环境变量示例
# 复制为 .env 后按需修改
# ============================================================

# 服务监听地址（仅本地使用，不要暴露到公网）
BOLDMAKER_HOST=127.0.0.1
BOLDMAKER_PORT=8010

# 本地数据根目录（每个 uid 一个子目录）
# 默认: local_userdata_Module/data
# BOLDMAKER_DATA_ROOT=

# 是否由本服务同时托管 front/ 静态前端
BOLDMAKER_SERVE_FRONTEND=true

# CORS 允许来源，多个用逗号分隔，* 表示全部
BOLDMAKER_CORS_ORIGINS=*

# 会话有效期（小时）
BOLDMAKER_SESSION_TTL_HOURS=168

# 单个上传文件最大体积（MB）
BOLDMAKER_MAX_UPLOAD_MB=2048

# 开发期允许通过 X-User-Id 请求头直接指定 uid（云登录未接通前方便前端联调）
BOLDMAKER_ALLOW_UID_HEADER=true

# 本地测试链路账号（账号 / 密码 / 对应 uid）
BOLDMAKER_TEST_ACCOUNT=test
BOLDMAKER_TEST_PASSWORD=test
BOLDMAKER_TEST_UID=test
